Diagnostics:
  UnusedIncludes: Strict
InlayHints:
  Enabled: No
  ParameterNames: No
  DeducedTypes: No
Hover:
  ShowAKA: Yes
CompileFlags:
  Add:
    - /std:c++20
    - -ferror-limit=0
    - -D_HAS_CXX17=1
    - -D_HAS_CXX20=1
    - -D_HAS_CXX23=0
    - -D_MSVC_LANG=202002L
  Remove:
    - /std:c++20
    - /MP
    - /Zc:preprocessor
  CompilationDatabase: "../build/Ninja_debug"
---
If:
  PathMatch: "script/uePlug/Doodle/Source/.*" # 使用正则表达式匹配整个 legacy_code 目录
Diagnostics:
  Suppress: "*"
